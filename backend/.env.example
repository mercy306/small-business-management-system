# Environment Variables — copy this to .env and fill in your values

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
APP_NAME="Small Business Management System"

# Database
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./sbms.db
# PostgreSQL (for production via Docker):
# DATABASE_URL=postgresql+asyncpg://sbms_user:sbms_pass@localhost:5432/sbms_db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Default admin account (used by seed.py)
ADMIN_EMAIL=admin@business.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=System Admin

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
